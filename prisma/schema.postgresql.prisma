// =============================================================================
// SCHEMA PRISMA OFICIAL PARA PRODUÇÃO: POSTGRESQL (Supabase / Neon / Docker / RDS)
// =============================================================================
// Para usar este schema:
// 1. Configure sua DATABASE_URL no .env com a URL do seu PostgreSQL / Supabase
// 2. Copie este arquivo para prisma/schema.prisma ou rode: npm run db:use-postgres
// 3. Execute: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PLAYER
}

enum TournamentType {
  ROUND_WEEKLY // Por Rodada (Semanal)
  MONTHLY_LEAGUE // Liga Mensal
}

enum TournamentStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum ScoreTypeAwarded {
  NONE
  EXACT
  WINNER_WITH_DIFF
  WINNER_ONLY
  PARTIAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         UserRole @default(PLAYER)
  pixKey       String?
  pixKeyType   String?
  avatar       String?
  favoriteTeam String? // Time do coração (Flamengo, Palmeiras, São Paulo, Corinthians, etc.)

  participants Participant[]
  predictions  Prediction[]
  payments     Payment[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Tournament {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  type        TournamentType   @default(ROUND_WEEKLY)
  status      TournamentStatus @default(OPEN)
  isActive    Boolean          @default(true)

  entryFee         Float   @default(10.00)
  prizePool        Float   @default(200.00)
  prizeDescription String? @default("1º Lugar: 100% da premiação")

  exactScorePoints Int @default(10)
  winnerPoints     Int @default(5)
  goalDiffPoints   Int @default(2)

  startDate           DateTime
  endDate             DateTime
  deadlinePredictions DateTime

  matches      Match[]
  participants Participant[]
  payments     Payment[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isActive])
  @@index([type])
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  homeTeam     String
  awayTeam     String
  homeTeamLogo String?
  awayTeamLogo String?
  stadium      String?
  matchDate    DateTime
  roundNumber  Int?        @default(1)

  status    MatchStatus @default(SCHEDULED)
  homeScore Int?
  awayScore Int?

  predictions Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([matchDate])
  @@index([status])
}

model Participant {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?

  totalPoints      Int  @default(0)
  exactScoresCount Int  @default(0)
  winnerPicksCount Int  @default(0)
  rankPosition     Int?

  predictions Prediction[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tournamentId])
  @@index([tournamentId, paymentStatus])
  @@index([tournamentId, totalPoints, exactScoresCount])
}

model Payment {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  provider          String        @default("MERCADO_PAGO")
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Float

  qrCodeBase64   String?
  qrCodeCopyPaste String?
  ticketUrl      String?
  rawWebhookData String?

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerPaymentId])
  @@index([userId, tournamentId])
  @@index([status])
}

model Prediction {
  id            String           @id @default(cuid())
  participantId String
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)

  homeScore Int
  awayScore Int

  pointsEarned Int              @default(0)
  scoreType    ScoreTypeAwarded @default(NONE)
  isLocked     Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, matchId])
  @@index([matchId])
  @@index([userId])
}

model ChatMessage {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  message      String
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
}
